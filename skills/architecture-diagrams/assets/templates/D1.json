{
  "archatlas": "0.1",
  "meta": {
    "type": "D1",
    "title": "Online shop: logical data model",
    "lang": "en",
    "audience": "developers and analysts",
    "state": "as-is",
    "subtitle": "Entities, keys and cardinalities",
    "legend": [
      {
        "label": "Cardinality at each end: minimum..maximum (* = many)",
