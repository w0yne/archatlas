{
  "archatlas": "0.1",
  "meta": {
    "type": "E3",
    "title": "Order: states",
    "lang": "en",
    "audience": "developers and analysts",
    "state": "as-is",
    "subtitle": "Lifecycle of one order, transitions as event [guard] / effect",
    "legend": [
      {
        "label": "Main path of a successful order",
        "style": "highlight",
        "symbol": "box"
      },
      {
        "label": "Transition: event [guard] / effect",
        "kind": "call",
        "dir": "->"
      }
    ],
    "legend_mode": "replace"
  },
  "layout": {
    "template": "statechart",
    "profile": "doc",
    "direction": "TB",
    "spacing": {
      "rank_gap": 36
    }
  },
  "nodes": [
    {
      "id": "i",
      "kind": "initial",
      "label": "Start"
    },
    {
      "id": "new",
      "kind": "state",
      "label": "Placed",
      "chips": [
        "Awaiting payment"
      ]
    },
    {
      "id": "paid",
      "kind": "state",
      "label": "Paid",
      "style": "highlight",
      "chips": [
        "Stock reserved"
      ]
    },
    {
      "id": "shipped",
      "kind": "state",
      "label": "Shipped",
      "style": "highlight",
      "chips": [
        "In transit"
      ]
    },
    {
      "id": "deliv",
      "kind": "state",
      "label": "Delivered",
      "style": "highlight",
      "chips": [
        "Return window open"
      ]
    },
    {
      "id": "refd",
      "kind": "state",
      "label": "Refunded",
      "chips": [
        "Money returned"
      ]
    },
    {
      "id": "cancelled",
      "kind": "state",
      "label": "Cancelled",
      "chips": [
        "Stock released"
      ]
    },
    {
      "id": "f",
      "kind": "final",
      "label": "End"
    }
  ],
  "edges": [
    {
      "from": "i",
      "to": "new"
    },
    {
      "from": "new",
      "to": "paid",
      "label": "pay [amount ok] / reserve stock",
      "kind": "call"
    },
    {
      "from": "paid",
      "to": "shipped",
      "label": "ship / notify customer",
      "kind": "call"
    },
    {
      "from": "shipped",
      "to": "deliv",
      "label": "deliver",
      "kind": "call"
    },
    {
      "from": "deliv",
      "to": "f",
      "label": "close [window over]",
      "kind": "call"
    },
    {
      "from": "deliv",
      "to": "refd",
      "label": "return [within 30 days] / refund",
      "kind": "call"
    },
    {
      "from": "refd",
      "to": "f",
      "label": "close",
      "kind": "call"
    },
    {
      "from": "new",
      "to": "cancelled",
      "label": "cancel [before payment]",
      "kind": "call"
    },
    {
      "from": "paid",
      "to": "cancelled",
      "label": "cancel [before shipping] / refund",
      "kind": "call"
    },
    {
      "from": "cancelled",
      "to": "f",
      "label": "close",
      "kind": "call"
    }
  ],
  "groups": []
}
