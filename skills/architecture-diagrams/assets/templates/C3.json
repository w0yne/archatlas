{
  "archatlas": "0.1",
  "meta": {
    "type": "C3",
    "title": "Container diagram for Online shop",
    "lang": "en",
    "audience": "architects and developers",
    "state": "as-is",
    "subtitle": "What runs inside the shop and how requests flow",
    "legend": [
      {
        "label": "Subject of this view",
        "style": "primary",
        "symbol": "box"
      },
      {
        "label": "Outside our control",
        "style": "external",
        "symbol": "box"
      },
      {
        "label": "Synchronous call",
        "kind": "call",
        "dir": "->"
      },
      {
        "label": "Asynchronous message",
        "kind": "async",
        "dir": "->",
        "dashed": true
      }
    ],
    "legend_mode": "replace"
  },
  "layout": {
    "template": "statechart",
    "profile": "doc",
    "direction": "LR",
    "max_width": 1700,
    "spacing": {
      "rank_gap": 28,
      "group_padding": 12,
      "node_gap": 16
