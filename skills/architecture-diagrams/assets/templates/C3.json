      "size_hint": {
        "width": 128
      }
    },
    {
      "id": "cat",
      "kind": "container",
      "label": "Catalogue service",
      "parent": "g_svc",
      "sub": "Products and prices",
      "chips": [
        "REST"
      ],
      "size_hint": {
        "width": 128
      }
    },
    {
      "id": "db",
      "kind": "store",
