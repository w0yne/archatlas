{
  "archatlas": "0.1",
  "meta": {
    "type": "F1",
    "title": "Shop: signed-in order history, authorization code flow (current)",
    "lang": "en",
    "audience": "security and developers",
    "state": "as-is",
    "subtitle": "The shopper never receives the access token"
  },
  "layout": {
    "template": "sequence",
    "profile": "doc"
  },
  "nodes": [
    {
      "id": "user",
      "kind": "lifeline",
      "label": "Shopper",
      "size_hint": {
        "width": 150
      }
    },
    {
      "id": "app",
      "kind": "lifeline",
      "label": "Web app",
      "style": "primary",
      "size_hint": {
        "width": 150
      }
    },
    {
      "id": "idp",
      "kind": "lifeline",
      "label": "Identity provider",
      "size_hint": {
        "width": 150
      }
    },
    {
      "id": "api",
      "kind": "lifeline",
      "label": "Order API",
      "size_hint": {
        "width": 150
      }
    }
  ],
  "edges": [
    {
      "from": "user",
      "to": "app",
      "label": "Open order history",
      "step": 1,
      "kind": "call"
    },
    {
      "from": "app",
      "to": "idp",
      "label": "Authorization request (redirect)",
      "step": 2,
      "kind": "call"
    },
    {
      "from": "user",
      "to": "idp",
      "label": "Sign in",
      "step": 3,
      "kind": "call"
    },
    {
      "from": "idp",
      "to": "app",
      "label": "Authorization code (redirect)",
      "step": 4,
      "kind": "call",
      "dashed": true
    },
    {
      "from": "app",
      "to": "idp",
      "label": "Code and verifier (back channel)",
      "step": 5,
      "kind": "call"
    },
    {
      "from": "idp",
      "to": "app",
      "label": "Access token",
      "step": 6,
      "kind": "call",
      "dashed": true
    },
    {
      "from": "app",
      "to": "api",
      "label": "Request orders with token",
      "step": 7,
      "kind": "call"
    },
    {
      "from": "api",
      "to": "idp",
      "label": "Fetch signing keys",
      "step": 8,
      "kind": "call"
    },
    {
      "from": "idp",
      "to": "api",
      "label": "Keys",
      "step": 9,
      "kind": "call",
      "dashed": true
    },
    {
      "from": "api",
      "to": "app",
      "label": "Order list",
      "step": 10,
      "kind": "call",
      "dashed": true
    },
    {
      "from": "app",
      "to": "user",
      "label": "Show orders",
      "step": 11,
      "kind": "call",
      "dashed": true
    },
    {
      "from": "api",
      "to": "app",
      "label": "401 Unauthorized",
      "step": 12,
      "kind": "call",
      "dashed": true
    },
    {
      "from": "app",
      "to": "idp",
      "label": "Start sign-in again",
      "step": 13,
      "kind": "call"
    }
