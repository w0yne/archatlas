  "groups": [],
  "frames": [
    {
      "id": "alt1",
      "operator": "alt",
      "label": "Token check",
      "from_step": 10,
      "to_step": 13,
      "operands": [
        {
          "guard": "token valid",
          "from_step": 10,
          "to_step": 11
        },
        {
          "guard": "else: token invalid or expired",
          "from_step": 12,
          "to_step": 13
        }
      ]
    }
  ],
  "activations": [
    {
      "node": "idp",
      "from_step": 2,
      "to_step": 6
    },
    {
      "node": "api",
      "from_step": 7,
      "to_step": 12
    }
  ]
