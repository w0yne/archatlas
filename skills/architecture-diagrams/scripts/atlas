#!/usr/bin/env python3
"""Prefer the release's bundled renderer, otherwise use the installed package."""
from pathlib import Path
import sys

vendored = Path(__file__).resolve().parent / "lib"
if vendored.is_dir():
    sys.path.insert(0, str(vendored))

try:
    from archatlas.cli import main
except ImportError:
    print("Renderer unavailable. From a reviewed checkout run 'python -m pip install -e .'; "
          "or use a release bundle with scripts/lib and install its scripts/requirements.txt.",
          file=sys.stderr)
    raise SystemExit(2)

raise SystemExit(main())
