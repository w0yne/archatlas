#!/usr/bin/env python3
"""Use the skill's venv and prefer its bundled renderer over an installed copy."""
import os
from pathlib import Path
import sys

script = Path(__file__).resolve()
venv = script.parent.parent / ".atlas-venv"
python = venv / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
# Venv interpreters may be symlinks to the very same system Python binary.
# Compare prefixes, not resolved executables, so that the first switch happens
# and the interpreter inside this venv does not restart itself.
if python.is_file() and Path(sys.prefix).resolve() != venv.resolve():
    try:
        os.execv(str(python), [str(python), str(script), *sys.argv[1:]])
    except OSError as error:
        print(f"Cannot start the skill's .atlas-venv interpreter: {error}", file=sys.stderr)
        raise SystemExit(2)

vendored = script.parent / "lib"
if vendored.is_dir():
    sys.path.insert(0, str(vendored))

try:
    from archatlas.cli import main
except ImportError:
    print("Renderer unavailable. Use a release bundle containing scripts/lib. "
          "To install renderer dependencies, run from the skill folder:\n"
          "python3 -m venv .atlas-venv && "
          ".atlas-venv/bin/python -m pip install -r scripts/requirements.txt",
          file=sys.stderr)
    raise SystemExit(2)

raise SystemExit(main())
